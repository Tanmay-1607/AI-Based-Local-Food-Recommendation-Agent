# =========================================================
# LocalBite AI — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit your actual .env file or real secrets to Git.
# =========================================================

# Backend AI Engine (Groq Cloud) - Required for live AI chat agent
# Get your free API key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Live Web Search (Tavily Search API) - Optional
# Get your API key at: https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# Backend Server Settings (Render automatically sets PORT)
PORT=8000
HOST=0.0.0.0
