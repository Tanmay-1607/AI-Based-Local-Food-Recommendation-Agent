# =========================================================
# LocalBite AI — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit your actual .env file or real secrets to Git.
# =========================================================

# Frontend Configuration (for Vercel Deployment)
# In Vercel Project Settings -> Environment Variables, add:
# Key: VITE_API_URL
# Value: https://your-backend-name.onrender.com (replace with your Render backend URL)
VITE_API_URL=https://your-backend-name.onrender.com

# Backend AI Engine (Groq Cloud)
# Get your free API key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Live Web Search (Tavily Search API)
# Get your API key at: https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# Backend Server Settings
PORT=8000
HOST=127.0.0.1
